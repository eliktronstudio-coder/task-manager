# Токен Telegram бота — получить у @BotFather в Telegram
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL вебхука — ваш публичный домен + /webhook (для production)
# Если не задан — бот работает через long polling (удобно локально)
WEBHOOK_URL=https://yourdomain.com/webhook

# Секрет для проверки запросов от Telegram (необязательно)
WEBHOOK_SECRET=

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/taskmanager.db
# Для production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/taskmanager

# Секретный ключ
APP_SECRET_KEY=change-me-in-production

# Telegram user ID администраторов (через запятую)
# Узнать свой ID: написать @userinfobot в Telegram
ADMIN_TG_IDS=123456789

DEBUG=false
